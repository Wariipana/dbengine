----------------
 t
(1 row)

SELECT (SELECT sum(hashtext(k || ':' || c || ':' || s)::bigint)
		FROM (SELECT k, count(*) c, sum(v) s FROM fpt GROUP BY k) x)
	 = (SELECT sum(hashtext(k || ':' || c || ':' || s)::bigint)
		FROM (SELECT k, count(*) c, sum(v) s FROM fpth GROUP BY k) y)
	AS paralelo_texto;
